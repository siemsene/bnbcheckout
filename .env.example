# Asset pipeline (server-side scripts only)
GEMINI_API_KEY=
RECRAFT_API_TOKEN=
ANTHROPIC_API_KEY=

# Firebase web app config (Vite exposes VITE_* to the client — these are public)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to connect to local emulators during development
VITE_USE_EMULATORS=
