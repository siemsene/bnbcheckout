rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isInstructor() {
      return signedIn() && request.auth.token.instructor == true;
    }

    // Instructor accounts. Created client-side as 'pending'; approval happens
    // server-side (approveInstructor), but admin-claim updates stay allowed.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Join codes — resolved only by the joinSession function. Open to clients,
    // this let any anonymous visitor list every live code and walk into any
    // class; nothing in the client reads it.
    match /sessionCodes/{code} {
      allow read, write: if false;
    }

    match /sessions/{sid} {
      // A student reads their own session by id. Listing is for the owning
      // instructor's dashboard query (where instructorUid == uid) only — an
      // open list handed every session id, and so every roster, to anyone.
      allow get: if signedIn();
      allow list: if isInstructor()
        && resource.data.instructorUid == request.auth.uid;
      allow create: if isInstructor()
        && request.resource.data.instructorUid == request.auth.uid;
      // The owning instructor may edit their session, but NOT the run timing or
      // the server-maintained counters: `runStartsAt` is the single timestamp
      // every student derives their stage and sim-clock from, so it is stamped
      // by the sessionControl/markReady functions or not at all. Ending the
      // session directly stays allowed as an escape hatch.
      allow update: if isInstructor()
        && resource.data.instructorUid == request.auth.uid
        && request.resource.data.instructorUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['runStartsAt', 'planOpensAt', 'run2StartsAt',
                      'readyCount', 'playerCount', 'code',
                      'settings', 'createdAt', 'planningOpenedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || request.resource.data.status == 'ended');
      allow delete: if false;

      // Name tickets — written only by the joinSession function.
      // Never read by clients; they carry every player's uid.
      match /names/{nameLower} {
        allow read, write: if false;
      }

      match /players/{playerId} {
        // Leaderboard is public to anyone signed in (incl. anonymous students).
        allow read: if signedIn();
        // Created only by the joinSession function.
        allow create: if false;
        // Owner may update their own summary; identity and seed are immutable
        // and the sim clock can only move forward. `ready` is control flow, not
        // a display value — it can start the whole room's run — so only the
        // markReady function may set it. The get(k, default) form keeps player
        // docs created before this field existed writable.
        allow update: if signedIn()
          && request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.name == resource.data.name
          && request.resource.data.seed == resource.data.seed
          // Sim time only moves forward WITHIN a run. Round 2 legitimately
          // restarts at minute 0, and an absolute check would deny every
          // round-2 progress write — silently, because writeProgress swallows
          // its errors, so the leaderboard would just freeze with nothing
          // logged anywhere. The round itself may never go backwards.
          && request.resource.data.get('round', 1) >= resource.data.get('round', 1)
          && (request.resource.data.get('round', 1) > resource.data.get('round', 1)
              || request.resource.data.simMinute >= resource.data.simMinute)
          && request.resource.data.get('ready', false) == resource.data.get('ready', false)
          // Only the progress summary may change, and only with sane values.
          // Without this an owner could write arbitrary (and arbitrarily large)
          // fields onto a document every classmate's leaderboard downloads.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'phase', 'round', 'simMinute', 'pctComplete', 'utilizationAvg',
               'finished', 'finishSimMinute', 'score', 'lastWriteAt'])
          && request.resource.data.phase in
               ['lobby', 'planning', 'running', 'finished', 'abandoned']
          && request.resource.data.get('round', 1) in [1, 2]
          && request.resource.data.simMinute is number
          && request.resource.data.simMinute >= 0
          && request.resource.data.simMinute <= 1440
          && request.resource.data.pctComplete is number
          && request.resource.data.pctComplete >= 0
          && request.resource.data.pctComplete <= 1
          && request.resource.data.utilizationAvg is number
          && request.resource.data.utilizationAvg >= 0
          && request.resource.data.utilizationAvg <= 1
          && request.resource.data.finished is bool
          && request.resource.data.score is number
          && (request.resource.data.finishSimMinute == null
              || request.resource.data.finishSimMinute is number);
        allow delete: if false;

        // Private per-player docs (checkpoint, result), one per round.
        // Only the owning student reads them; no instructor screen does, and
        // the old `|| isInstructor()` let ANY instructor read any class's.
        // Doc ids and keys are fixed so a client cannot pile up storage.
        match /private/{doc} {
          function playerUid() {
            return get(/databases/$(database)/documents/sessions/$(sid)/players/$(playerId)).data.uid;
          }
          allow read: if signedIn() && request.auth.uid == playerUid();
          allow create, update: if signedIn()
            && doc in ['checkpoint', 'result', 'checkpoint-2', 'result-2']
            && request.auth.uid == playerUid()
            && request.resource.data.uid == request.auth.uid
            && (doc.matches('result.*')
                ? request.resource.data.keys().hasOnly(['json', 'uid', 'savedAt'])
                  && request.resource.data.json is string
                  && request.resource.data.json.size() < 200000
                : request.resource.data.keys().hasOnly(
                    ['engineVersion', 'seed', 'round', 'tick', 'stateJSON',
                     'uid', 'savedAt'])
                  && request.resource.data.stateJSON is string);
          allow delete: if signedIn() && request.auth.uid == playerUid();
        }
      }
    }

    // Lifetime usage counters, written by the purge and by deleteSession.
    // Closed to clients in both directions: the admin screen reads these
    // through the usageStats callable, and nothing else has any business
    // seeing — let alone editing — how much every instructor has used.
    match /usageArchive/{uid} {
      allow read, write: if false;
    }

    // Trigger Email extension queue — functions only, never clients.
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
